<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-Company Record Rules for Holidays -->
        
        <!-- Rule: Users can see global holidays and their company's holidays -->
        <record id="jalaali_holiday_company_rule" model="ir.rule">
            <field name="name">Holiday Multi-Company Rule</field>
            <field name="model_id" ref="model_jalaali_holiday"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="global" eval="True"/>
        </record>

        <!-- Rule: Managers can edit all holidays -->
        <record id="jalaali_holiday_manager_rule" model="ir.rule">
            <field name="name">Holiday Manager Full Access</field>
            <field name="model_id" ref="model_jalaali_holiday"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Rule: Regular users can only read holidays -->
        <record id="jalaali_holiday_user_read_rule" model="ir.rule">
            <field name="name">Holiday User Read Only</field>
            <field name="model_id" ref="model_jalaali_holiday"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>
    </data>
</odoo>
