<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- User Form View - Extended with Jalali Preferences -->
        <record id="res_users_view_form_jalali" model="ir.ui.view">
            <field name="name">res.users.form.jalali</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='preferences']" position="inside">
                    <separator string="Persian Calendar Preferences"/>
                    <group>
                        <group string="Date Format">
                            <field name="jalali_date_format"/>
                            <field name="jalali_default_view"/>
                        </group>
                        <group string="Display Options">
                            <field name="jalali_show_gregorian"/>
                            <field name="jalali_use_persian_numbers"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
